{
  "name": "soclear",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @soclear/api --filter @soclear/web dev",
    "dev:web": "pnpm --filter @soclear/web dev",
    "dev:api": "pnpm --filter @soclear/api dev",
    "build": "pnpm --filter @soclear/web build && pnpm --filter @soclear/api typecheck",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @soclear/api test"
  }
}
