# Local BFF (synthetic data only; no secrets required for P1)
API_HOST=127.0.0.1
API_PORT=8787
# Replace before any non-local deployment. Used for opaque pagination cursors.
CURSOR_SECRET=local-development-only-change-me
# Per-IP request budget for /api/v1/public/**; both values are optional.
RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW_MS=60000
# Local PGlite data directory. Use memory:// for an ephemeral database.
DATABASE_PATH=.data/pglite
# Signs demo session cookies and CSRF tokens. Replace before any non-local run.
SESSION_SECRET=local-development-session-secret
# Login attempts per IP and window; optional.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Local demo accounts only. Never enable in production.
DEMO_AUTH=true
# Set to true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
